{
  "manifest_version": 3,
  "name": "Memory Wallpaper",
  "version": "1.0.0",
  "description": "Privacy-first local browser memory for an evolving desktop wallpaper.",
  "permissions": [
    "tabs",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Memory Wallpaper"
  },
  "options_page": "options.html"
}
